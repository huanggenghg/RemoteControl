<resources>
    <style name="BaseAutoclickTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/ac_primary</item>
        <item name="colorOnPrimary">@color/ac_on_primary</item>
        <item name="colorPrimaryContainer">@color/ac_soft</item>
        <item name="colorOnPrimaryContainer">@color/ac_primary_pressed</item>
        <item name="colorSecondary">@color/ac_primary</item>
        <item name="colorOnSecondary">@color/ac_on_primary</item>
        <item name="colorSurface">@color/ac_surface</item>
        <item name="colorOnSurface">@color/ac_text</item>
        <item name="colorOnSurfaceVariant">@color/ac_text_secondary</item>
        <item name="colorOutline">@color/ac_border</item>
        <item name="colorError">@color/ac_error</item>
        <item name="colorAccent">@color/ac_primary</item>
        <item name="android:colorAccent">@color/ac_primary</item>
        <item name="android:colorBackground">@color/ac_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/ac_background</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.MyApp" parent="BaseAutoclickTheme" />
    <style name="FullScreenWidthDialog" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.32</item>
        <item name="colorPrimary">@color/ac_primary</item>
    </style>
    <style name="AutoclickPanel">
        <item name="android:background">@drawable/ac_panel</item>
        <item name="android:padding">24dp</item>
    </style>
    <style name="AutoclickButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
    </style>
</resources>
