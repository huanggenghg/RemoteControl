<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/adb_setup_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="24dp"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/adb_setup_instructions" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/adb_open_settings_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adb_open_settings" />

            <EditText
                android:id="@+id/adb_connect_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/adb_connect_port"
                android:inputType="number"
                android:maxLength="5" />

            <EditText
                android:id="@+id/adb_pair_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/adb_pair_port"
                android:inputType="number"
                android:maxLength="5" />

            <EditText
                android:id="@+id/adb_pair_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/adb_pair_code"
                android:importantForAutofill="no"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:saveEnabled="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/adb_pair_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adb_pair" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
